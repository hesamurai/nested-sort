{
  "name": "nested-sort",
  "version": "5.2.0",
  "author": "Hesam Bahrami (hesamurai)",
  "description": "A JavaScript library for sorting a nested list of items via drag and drop.",
  "umdClassName": "NestedSort",
  "type": "module",
  "module": "dist/nested-sort.js",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/nested-sort.js"
    }
  },
  "browser": "dist/nested-sort.umd.js",
  "browserMin": "dist/nested-sort.umd.min.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hesamurai/nested-sort"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "trustedDependencies": [
    "husky"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@typescript-eslint/eslint-plugin": "^5.59.5",
    "@typescript-eslint/parser": "^5.59.5",
    "eslint": "^7.32.0",
    "husky": "^4.3.8",
    "jsdom": "^16.7.0",
    "typescript": "^5.0.4"
  },
  "scripts": {
    "prepare": "bun run build",
    "build": "bun run build:js && bun run build:types",
    "build:types": "tsc --emitDeclarationOnly && mkdir -p dist/types && cp src/types/index.d.ts dist/types/index.d.ts",
    "build:js": "bun run scripts/build.ts",
    "dev": "bun --hot dev/dev-server.ts",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.js'",
    "typecheck": "tsc --noEmit && tsc --noEmit -p dev/tsconfig.json",
    "test": "bun test && bun run typecheck && bun run build",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch"
  },
  "files": [
    "dist"
  ]
}
